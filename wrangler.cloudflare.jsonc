{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wb-insight",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "workers_dev": false,
  "triggers": { "crons": ["10 6,8,14 * * *"] },
  "routes": [
    { "pattern": "wbwork.duoduolink.com", "zone_name": "duoduolink.com", "custom_domain": true }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "c0681839d2ae4d8db3a526e6da8e9f56"
    }
  ],
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "SUPABASE_URL": "https://dbwnzmwlmpwcmyhzapug.supabase.co"
  },
  "observability": {
    "enabled": true
  }
}
